# Backend configuration (node-server/src/server.js)
# Copy to .env (do not commit secrets). These defaults work for local dev.

# Relying party identifier (must match host of Origin)
RP_ID=localhost

# Browser origin the server expects for WebAuthn ceremonies
ORIGIN=http://localhost:5173

# HTTP listen port for the Node API
PORT=8080

# SQLite database path (relative to repo root or absolute)
DB_PATH=demo.db

# Optional logging configuration
# LOG_LEVEL=info   # debug|info|warn|error (default info)
# LOG_FORMAT=json  # json|text (default json)
